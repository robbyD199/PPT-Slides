{
  "name": "slide-library",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "config": {
    "app_to_debug": "powerpoint",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "prebuild": "node scripts/gen-manifest.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "start": "office-addin-debugging start manifest.dev.xml",
    "stop": "office-addin-debugging stop manifest.dev.xml",
    "validate": "node scripts/gen-manifest.js && office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest.dev.xml",
    "test": "jest",
    "update-templates": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-templates.ps1",
    "lint-templates": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lint-templates.ps1",
    "selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/selftest.ps1",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint-plugin-office-addins": "^4.0.10",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jszip": "^3.10.2",
    "mini-css-extract-plugin": "^2.10.2",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 Edge versions",
    "last 2 Chrome versions"
  ],
  "private": true
}
