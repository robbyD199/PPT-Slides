{
  "library": "Consulting slide template",
  "version": "2.0",
  "note": "MECE-Taxonomie der Folienbibliothek. Regel: Kategorie = wichtigstes Darstellungsmittel bzw. Funktion im Deck (siehe docs/TAXONOMIE.md).",
  "slide": {
    "width": 960,
    "height": 540,
    "unit": "pt",
    "boxFormat": "[left, top, width, height]",
    "contentAreaFormat": "[left, top, right, bottom]"
  },
  "categories": [
    {
      "id": "layouts",
      "name": "Grundlayouts",
      "rule": "Leere Folien mit den Master-Layouts der Vorlage – der schnellste Start für eigene Inhalte.",
      "subcategories": [
        "Leere Layouts"
      ]
    },
    {
      "id": "structure",
      "name": "Struktur & Storyline",
      "rule": "Folien, die das Deck rahmen: Deckblatt, Einleitung, Executive Summary, Abschluss und Quellen.",
      "subcategories": [
        "Deckblatt",
        "Einleitung & Vorstellung",
        "Executive Summary",
        "Abschluss & Call-to-Action",
        "Quellen & Anhang"
      ]
    },
    {
      "id": "text",
      "name": "Text & Kernaussagen",
      "rule": "Inhalte, die vor allem über Text wirken: Aufzählungen, Fließtext, Spalten und Karten mit Icons.",
      "subcategories": [
        "Aufzählung",
        "Fließtext",
        "Spalten & Bereiche",
        "Karten & Icons"
      ]
    },
    {
      "id": "charts",
      "name": "Diagramme",
      "rule": "Datengetriebene Diagramme (editierbare Diagrammdaten): Linien, Säulen, Wasserfall, Blasen.",
      "subcategories": [
        "Linien",
        "Säulen",
        "Wasserfall",
        "Blasen"
      ]
    },
    {
      "id": "figures",
      "name": "Kennzahlen & Tabellen",
      "rule": "Zahlen ohne Diagramm: Key-Facts-Kacheln und Status-/KPI-Tabellen.",
      "subcategories": [
        "Key Facts",
        "Tabellen"
      ]
    },
    {
      "id": "frameworks",
      "name": "Frameworks & Matrizen",
      "rule": "Konzeptionelle Strukturen: Matrizen und Portfolios (auch als Blasendiagramm), Hub & Spoke, Issue Trees, Säulenmodelle.",
      "subcategories": [
        "Matrix & Portfolio",
        "Hub & Spoke",
        "Issue Tree",
        "Säulen & Bausteine"
      ]
    },
    {
      "id": "process",
      "name": "Prozesse & Phasen",
      "rule": "Abfolgen ohne Zeitachse: Phasenmodelle, Schrittfolgen, Treppen und Kaskaden.",
      "subcategories": [
        "Phasenübersicht",
        "Phase im Detail",
        "Schrittfolge",
        "Treppe & Kaskade"
      ]
    },
    {
      "id": "timeline",
      "name": "Zeitpläne & Roadmaps",
      "rule": "Alles mit Zeitachse: Gantt-/Projektpläne, Phasen- und Wellen-Roadmaps mit Meilensteinen.",
      "subcategories": [
        "Projektplan & Gantt",
        "Phasen-Roadmap"
      ]
    },
    {
      "id": "people",
      "name": "Team & Organisation",
      "rule": "Organigramme, Projektteams und Rollen.",
      "subcategories": [
        "Organigramm",
        "Team & Rollen"
      ]
    }
